{
  "mcpServers": {
    "everyinfra": {
      "type": "streamableHttp",
      "url": "https://api-cn.everyinfra.com/mcp",
      "headers": {
        "Authorization": "Bearer ${EVERYINFRA_API_KEY}"
      },
      "timeout": 100000,
      "disabledTools": [
        "everyinfra_chat",
        "everyinfra_list_captcha_types",
        "everyinfra_solve_captcha"
      ]
    }
  }
}
