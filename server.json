{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.xiaoxihexiaoyu/everyinfra",
  "title": "EveryInfra",
  "description": "Structured data from 90 platforms (RedNote, Douyin, TikTok, Amazon), web search, CAPTCHA solving.",
  "version": "1.1.1",
  "websiteUrl": "https://everyinfra.com/en/mcp-server?utm_source=mcp_registry&utm_medium=directory&utm_campaign=listing_2026q4",
  "repository": {
    "url": "https://github.com/everyinfra/everyinfra-agent-plugins",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://everyinfra.com/brand/everyinfra-mark.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.everyinfra.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {api_key}",
          "variables": {
            "api_key": {
              "description": "Your EveryInfra API key (new keys start with ei_). Create one at https://everyinfra.com/app. Capability discovery works without it; tool calls need it.",
              "isRequired": true,
              "isSecret": true,
              "format": "string",
              "placeholder": "ei_..."
            }
          }
        }
      ]
    }
  ]
}
